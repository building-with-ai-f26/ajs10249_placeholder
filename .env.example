# Copy this file to .env and fill it in:   cp .env.example .env
# NEVER commit .env. Keep the OAuth client file and token OUTSIDE the repo and OneDrive.

# Where data comes from: sample (fake data, default) | xlsx (read-only Excel copy) | google (live sheet)
DATA_SOURCE=sample

# google mode: the ID is the long string in the sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=
GOOGLE_OAUTH_CLIENT_FILE=C:/Users/you/srecrm-private/oauth-client.json
GOOGLE_TOKEN_FILE=C:/Users/you/srecrm-private/token.json

# xlsx mode: a File > Download > .xlsx copy of the sheet
XLSX_FILE=C:/Users/you/srecrm-private/master.xlsx

# Firm profiles from the web (OpenRouter). Set a credit limit on the key.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
ORG_PROFILE_CACHE_FILE=C:/Users/you/srecrm-private/org-profiles.json
